# ==========================================
# SKILLBRIDGE ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key (Server-side AI recommendations)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Configuration (Authentication & Database)
# Get your free project at: https://supabase.com/
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Server Port
PORT=5000

# Note: If these keys are left empty, SkillBridge will automatically operate in
# full DEMO MODE with simulated AI matching, mock database, and local progress tracking!
